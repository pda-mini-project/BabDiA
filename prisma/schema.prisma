// 점메추 ERD 기반 스키마
// 사용: npx prisma generate

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql" // mysql, sqlite 등으로 변경 가능
  url      = env("DATABASE_URL")
}

// ── 유저 ──
model User {
  id        Int      @id @default(autoincrement())
  loginId   String   @map("login_id")
  password  String
  nickname  String
  createdAt DateTime @default(now()) @map("created_at")

  reviews Review[]

  @@map("users")
}

// ── 식당 ──
model Restaurant {
  id            Int      @id @default(autoincrement())
  name          String
  imageUrl      String?  @map("image_url")
  naverLink     String?  @map("naver_link")
  recommendMenu String?  @map("recommend_menu")
  locationText  String?  @map("location_text")
  priceRange    String?  @map("price_range")
  createdAt     DateTime @default(now()) @map("created_at")

  reviews         Review[]
  restaurantTags   RestaurantTag[]

  @@map("restaurants")
}

// ── 후기 ──
model Review {
  id           Int      @id @default(autoincrement())
  restaurantId Int      @map("restaurant_id")
  userId       Int      @map("user_id")
  uuid         String   @unique
  rating       Int
  content      String?  @db.Text
  createdAt    DateTime @default(now()) @map("created_at")

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@index([userId])
  @@map("reviews")
}

// ── 태그 카테고리 ──
model TagCategory {
  id        Int      @id @default(autoincrement())
  name      String
  code      String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  tags Tag[]

  @@map("tag_categories")
}

// ── 태그 ──
model Tag {
  id             Int      @id @default(autoincrement())
  name           String
  groupName      String?  @map("group_name")
  tagCategoryId  Int      @map("tag_category_id")
  createdAt      DateTime @default(now()) @map("created_at")

  tagCategory    TagCategory      @relation(fields: [tagCategoryId], references: [id], onDelete: Cascade)
  restaurantTags RestaurantTag[]

  @@index([tagCategoryId])
  @@map("tags")
}

// ── 식당-태그 (다대다 중간 테이블) ──
model RestaurantTag {
  id           Int @id @default(autoincrement())
  restaurantId Int @map("restaurant_id")
  tagId        Int @map("tag_id")

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  tag         Tag        @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, tagId])
  @@index([restaurantId])
  @@index([tagId])
  @@map("restaurant_tags")
}
